---
export interface Props {
  defaultTarget?: number;
  showCustomTarget?: boolean;
}

const { defaultTarget = 100, showCustomTarget = true } = Astro.props;

const presetTargets = [20, 30, 50, 100, 200];
---

<div class="compress-tool" data-default-target={defaultTarget}>
  <!-- Target Size Selector -->
  <div class="mb-5 flex flex-wrap items-center gap-2">
    <span class="mr-1 font-mono text-[11px] font-medium uppercase tracking-[0.08em] text-stone-400">Target</span>
    {presetTargets.map((kb) => (
      <button
        data-target={kb}
        class="target-btn inline-flex min-h-[40px] items-center rounded-lg border px-3.5 font-mono text-[13px] font-medium transition duration-200 ease-out border-stone-200 bg-white text-stone-600 hover:border-stone-400 hover:text-stone-900 active:scale-[0.97]"
      >
        {kb}KB
      </button>
    ))}
    {showCustomTarget && (
      <div class="flex items-center gap-2">
        <input
          type="number"
          id="custom-target"
          placeholder="Custom"
          aria-label="Custom target size in kilobytes"
          autocomplete="off"
          min="1"
          max="5000"
          class="inline-flex h-[40px] w-24 items-center rounded-lg border border-stone-200 bg-white px-3 font-mono text-[13px] text-stone-900 placeholder:font-sans placeholder:text-stone-400 transition-colors focus:border-accent-600 focus:outline-none focus:ring-2 focus:ring-accent-600/20"
        />
        <button id="custom-target-btn" class="inline-flex min-h-[40px] items-center rounded-lg border border-stone-200 bg-white px-3.5 font-mono text-[13px] font-medium text-stone-600 transition duration-200 hover:border-stone-400 hover:text-stone-900 active:scale-[0.97]">Set</button>
      </div>
    )}
  </div>

  <!-- Hidden file input -->
  <input type="file" id="file-input" accept="image/png,image/jpeg,image/webp" style="display:none !important;" aria-hidden="true" tabindex="-1" />

  <!-- Upload area -->
  <div class="upload-shell">
    <div
      id="upload-area"
      class="relative flex cursor-pointer flex-col items-center justify-center gap-4 rounded-xl border-2 border-dashed border-stone-300 bg-stone-50/60 px-8 py-14 text-center transition duration-200 ease-out hover:border-accent-500 hover:bg-accent-50/70"
    >
      <span class="flex items-center justify-center rounded-xl bg-accent-100 text-accent-700 transition-transform duration-200 ease-out" id="upload-icon">
        <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5"></path>
        </svg>
      </span>
      <div>
        <p class="text-[15px] font-semibold tracking-tight text-stone-900">Drop your image here</p>
        <p class="mt-1 text-sm text-stone-500">or click to browse files</p>
      </div>
      <p class="font-mono text-[11px] uppercase tracking-[0.08em] text-stone-400">JPG &middot; PNG &middot; WebP &middot; up to 20MB</p>
    </div>
  </div>

  <!-- Loading -->
  <div id="loading" class="hidden py-12 text-center" aria-live="polite">
    <div class="mx-auto max-w-sm">
      <div class="h-1.5 overflow-hidden rounded-full bg-stone-200">
        <div class="shimmer-bar h-full w-1/3 rounded-full bg-accent-600"></div>
      </div>
      <p id="loading-message" class="mt-5 text-sm font-medium text-stone-800">Preparing compression&hellip;</p>
      <p class="mt-1 text-xs text-stone-500">This usually takes a few seconds</p>
    </div>
  </div>

  <!-- Results -->
  <div id="results" class="hidden mt-6">
    <div class="rounded-xl border border-stone-200 bg-white p-5 md:p-6">
      <div class="mb-6 grid grid-cols-1 gap-3 md:grid-cols-3">
        <div class="rounded-lg bg-stone-50 p-4 text-center">
          <p class="font-mono text-[11px] font-medium uppercase tracking-[0.08em] text-stone-400">Original</p>
          <p id="original-size" class="mt-1.5 font-mono text-lg font-semibold tracking-tight text-stone-900">--</p>
        </div>
        <div class="rounded-lg bg-stone-50 p-4 text-center">
          <p class="font-mono text-[11px] font-medium uppercase tracking-[0.08em] text-stone-400">Compressed</p>
          <p id="compressed-size" class="mt-1.5 font-mono text-lg font-semibold tracking-tight text-stone-900">--</p>
        </div>
        <div class="rounded-lg bg-accent-50 p-4 text-center">
          <p class="font-mono text-[11px] font-medium uppercase tracking-[0.08em] text-accent-700/70">Saved</p>
          <p id="saved-percent" class="mt-1.5 font-mono text-lg font-semibold tracking-tight text-accent-700">--</p>
        </div>
      </div>

      <!-- Image Preview -->
      <div class="mb-6 grid grid-cols-1 gap-4 md:grid-cols-2">
        <div>
          <p class="mb-2 font-mono text-[11px] font-medium uppercase tracking-[0.08em] text-stone-400">Original preview</p>
          <div class="rounded-lg border border-stone-200 bg-stone-50 p-2.5">
            <img id="original-preview" class="h-44 w-full rounded-md object-contain" alt="Original image preview" />
          </div>
        </div>
        <div>
          <p class="mb-2 font-mono text-[11px] font-medium uppercase tracking-[0.08em] text-stone-400">Compressed preview</p>
          <div class="rounded-lg border border-stone-200 bg-stone-50 p-2.5">
            <img id="compressed-preview" class="h-44 w-full rounded-md object-contain" alt="Compressed image preview" />
          </div>
        </div>
      </div>

      <div class="flex flex-wrap items-center justify-center gap-3">
        <a id="download-btn" class="group inline-flex cursor-pointer items-center gap-2.5 rounded-full bg-stone-900 py-2 pl-5 pr-1.5 text-sm font-semibold text-white transition duration-200 ease-out hover:bg-stone-700 active:scale-[0.98]">
          Download compressed image
          <span class="flex h-8 w-8 items-center justify-center rounded-full bg-white/15 transition-transform duration-200 ease-out group-hover:translate-y-0.5">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M7.5 12L12 16.5m0 0l4.5-4.5m-4.5 4.5V3"></path>
            </svg>
          </span>
        </a>
        <button id="compress-another" class="inline-flex items-center gap-2 rounded-full border border-stone-300 bg-white px-5 py-2.5 text-sm font-medium text-stone-700 transition duration-200 hover:border-stone-400 hover:text-stone-900 active:scale-[0.98]">
          <svg class="h-4 w-4 text-stone-400" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99"></path>
          </svg>
          Compress another
        </button>
      </div>
    </div>
  </div>

  <!-- Error -->
  <div id="error" class="hidden mt-4 rounded-lg border border-red-200 bg-red-50 p-4 text-center text-sm font-medium text-red-800" role="alert"></div>
</div>

<style>
  .compress-tool { padding: 4px 2px 2px; }
  #upload-icon { width: 52px; height: 52px; }
  #upload-area.is-dragover { border-color: var(--accent); background: var(--accent-soft); }
  .shimmer-bar { animation: shimmer-slide 1.2s cubic-bezier(0.4, 0, 0.2, 1) infinite; }
  #results img { background: transparent; }
  @keyframes shimmer-slide { 0% { transform: translateX(-120%); } 100% { transform: translateX(420%); } }
  @media (hover: hover) { #upload-area:hover #upload-icon { transform: translateY(-2px); } }
  @media (prefers-reduced-motion: reduce) { .shimmer-bar { animation: none; transform: none; } #upload-area:hover #upload-icon { transform: none; } }
</style>

<script>
  (function() {
    const tool = document.querySelector('.compress-tool[data-default-target]') || document.currentScript.closest('.compress-tool');
    if (!tool) {
      console.error('CompressTool: Failed to find tool container');
      return;
    }
    const defaultTarget = parseInt(tool.dataset.defaultTarget) || 100;
    let currentTarget = defaultTarget;
    let originalFileName = '';
    let originalPreviewUrl = '';
    let compressedPreviewUrl = '';

    const uploadArea = tool.querySelector('#upload-area');
    const fileInput = tool.querySelector('#file-input');
    const loading = tool.querySelector('#loading');
    const results = tool.querySelector('#results');
    const error = tool.querySelector('#error');
    const targetBtns = tool.querySelectorAll('.target-btn');
    const customTargetInput = tool.querySelector('#custom-target');
    const customTargetBtn = tool.querySelector('#custom-target-btn');
    const compressAnotherBtn = tool.querySelector('#compress-another');
    const downloadBtn = tool.querySelector('#download-btn');
    const loadingMessage = loading.querySelector('#loading-message');

    // Override at build time with PUBLIC_COMPRESSION_WORKER_URL when the proxy moves.
    const WORKER_URL = import.meta.env.PUBLIC_COMPRESSION_WORKER_URL
      || 'https://imgcompressortool-proxy.paswanrounak55.workers.dev/shrink';
    function formatSize(bytes) {
      if (bytes < 1024) return bytes + ' B';
      if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
      return (bytes / (1024 * 1024)).toFixed(2) + ' MB';
    }

    function updateTargetButtons() {
      targetBtns.forEach(btn => {
        const target = parseInt(btn.dataset.target);
        if (target === currentTarget) {
          btn.classList.add('bg-stone-900', 'text-white', 'border-stone-900');
          btn.classList.remove('border-stone-200', 'bg-white', 'text-stone-600', 'hover:border-stone-400', 'hover:text-stone-900');
        } else {
          btn.classList.remove('bg-stone-900', 'text-white', 'border-stone-900');
          btn.classList.add('border-stone-200', 'bg-white', 'text-stone-600', 'hover:border-stone-400', 'hover:text-stone-900');
        }
      });
      if (customTargetInput) customTargetInput.value = '';
    }

    function setTarget(target) {
      currentTarget = target;
      updateTargetButtons();
    }

    function setLoadingMessage(message) {
      if (loadingMessage) {
        loadingMessage.textContent = message;
      }
    }

    async function compressWithTinyPng(file) {
      // Use server-side proxy for compression
      // Server handles: compression + downloading compressed image (avoids CORS issues)
      // Show compression status
      setLoadingMessage('Optimizing your image…');

      try {
        console.log('Starting compression for:', file.name, 'Size:', file.size, 'Type:', file.type);

        const resp = await fetch(WORKER_URL, {
          method: 'POST',
          headers: {
            'Content-Type': file.type || 'application/octet-stream'
          },
          body: file
        });

        // Handle quota exceeded (429)
        if (resp.status === 429) {
          throw new Error('Daily compression quota exceeded. Try again tomorrow.');
        }

        if (!resp.ok) {
          let errorText = '';
          try {
            errorText = await resp.text();
          } catch (e) {
            errorText = 'Unknown error';
          }

          console.error('Compression error:', resp.status, errorText);

          // Better error messages
          if (resp.status === 400) {
            throw new Error('Invalid image format. Supports JPG, PNG, WebP.');
          } else if (resp.status === 401 || resp.status === 403) {
            throw new Error('Compression service authentication failed.');
          } else if (resp.status === 500) {
            throw new Error('Compression service error. Try again later.');
          }

          throw new Error(`Compression failed (${resp.status})`);
        }

        // Download compressed image
        setLoadingMessage('Finalizing compressed image…');
        const blob = await resp.blob();

        return { blob };
      } catch (error) {
        console.error('Image compression error:', error);
        throw error;
      }
    }

    function loadImage(fileOrBlob) {
      return new Promise((resolve, reject) => {
        const image = new Image();
        const objectUrl = URL.createObjectURL(fileOrBlob);

        image.onload = () => {
          URL.revokeObjectURL(objectUrl);
          resolve(image);
        };
        image.onerror = () => {
          URL.revokeObjectURL(objectUrl);
          reject(new Error('The image could not be decoded in this browser.'));
        };
        image.src = objectUrl;
      });
    }

    function canvasToBlob(canvas, quality) {
      return new Promise((resolve, reject) => {
        canvas.toBlob(
          (blob) => blob ? resolve(blob) : reject(new Error('Canvas encoding failed.')),
          'image/jpeg',
          quality
        );
      });
    }

    async function findBestQuality(canvas, targetBytes) {
      const minimumQuality = 0.05;
      const minimumBlob = await canvasToBlob(canvas, minimumQuality);
      if (minimumBlob.size > targetBytes) return null;

      let bestBlob = minimumBlob;
      let low = minimumQuality;
      let high = 0.95;

      // Keep the highest JPEG quality that stays under the requested limit.
      for (let attempt = 0; attempt < 8; attempt += 1) {
        const quality = (low + high) / 2;
        const candidate = await canvasToBlob(canvas, quality);
        if (candidate.size <= targetBytes) {
          bestBlob = candidate;
          low = quality;
        } else {
          high = quality;
        }
      }

      return bestBlob;
    }

    async function compressWithCanvas(fileOrBlob, targetKB) {
      const targetBytes = targetKB * 1024;
      const image = await loadImage(fileOrBlob);
      const canvas = document.createElement('canvas');
      const context = canvas.getContext('2d', { alpha: false });
      if (!context) throw new Error('Canvas is unavailable in this browser.');

      let width = image.naturalWidth;
      let height = image.naturalHeight;
      const maximumDimension = 4096;
      const initialScale = Math.min(1, maximumDimension / Math.max(width, height));
      width = Math.max(1, Math.round(width * initialScale));
      height = Math.max(1, Math.round(height * initialScale));

      for (let resizeAttempt = 0; resizeAttempt < 12; resizeAttempt += 1) {
        canvas.width = width;
        canvas.height = height;
        context.fillStyle = '#FFFFFF';
        context.fillRect(0, 0, width, height);
        context.drawImage(image, 0, 0, width, height);

        const result = await findBestQuality(canvas, targetBytes);
        if (result) return result;

        // Quality alone was insufficient, so reduce pixel dimensions and retry.
        width = Math.max(1, Math.round(width * 0.78));
        height = Math.max(1, Math.round(height * 0.78));
      }

      throw new Error(`This image could not be reduced below ${targetKB}KB.`);
    }

    async function compressToTargetSize(file, targetKB) {
      const targetBytes = targetKB * 1024;
      if (file.size <= targetBytes) {
        return { blob: file, method: 'Original' };
      }

      setLoadingMessage('Compressing with TinyPNG API…');

      try {
        const tinyResult = await compressWithTinyPng(file);
        const blob = tinyResult.blob;

        if (blob.size <= targetBytes) {
          return { blob, method: 'TinyPNG' };
        }

        setLoadingMessage(`Reducing dimensions to stay under ${targetKB}KB…`);
        const canvasBlob = await compressWithCanvas(blob, targetKB);
        return { blob: canvasBlob, method: 'TinyPNG+Canvas' };
      } catch (err) {
        console.warn('TinyPNG compression failed, falling back to Canvas:', err);
        setLoadingMessage('Falling back to local Canvas compression…');
        try {
          const fallback = await compressWithCanvas(file, targetKB);
          return { blob: fallback, method: 'Canvas' };
        } catch (fallbackErr) {
          console.error('Both TinyPNG and Canvas compression failed:', fallbackErr);
          throw fallbackErr;
        }
      }
    }

    async function processFile(file) {
      if (!file) return;

      const validTypes = ['image/jpeg', 'image/png', 'image/webp'];
      if (!validTypes.includes(file.type)) {
        showError('Please upload a JPG, PNG, or WebP image.');
        return;
      }

      if (file.size > 20 * 1024 * 1024) {
        showError('File too large. Maximum size is 20MB.');
        return;
      }

      originalFileName = file.name.replace(/\.[^/.]+$/, '');

      tool.querySelector('.upload-shell').classList.add('hidden');
      results.classList.add('hidden');
      error.classList.add('hidden');
      loading.classList.remove('hidden');
      setLoadingMessage('Preparing compression…');

      try {
        const { blob } = await compressToTargetSize(file, currentTarget);
        if (blob.size > currentTarget * 1024) {
          throw new Error(`The result is above the selected ${currentTarget}KB limit.`);
        }

        tool.querySelector('#original-size').textContent = formatSize(file.size);
        tool.querySelector('#compressed-size').textContent = formatSize(blob.size);

        const saved = Math.max(0, file.size - blob.size);
        const savedPercent = file.size > 0 ? Math.round((saved / file.size) * 100) : 0;
        tool.querySelector('#saved-percent').textContent = savedPercent + '%';

        clearPreviewUrls();
        originalPreviewUrl = URL.createObjectURL(file);
        tool.querySelector('#original-preview').src = originalPreviewUrl;

        compressedPreviewUrl = URL.createObjectURL(blob);
        tool.querySelector('#compressed-preview').src = compressedPreviewUrl;

        const extensions = {
          'image/jpeg': 'jpg',
          'image/png': 'png',
          'image/webp': 'webp'
        };
        const ext = extensions[blob.type] || 'jpg';
        downloadBtn.href = compressedPreviewUrl;
        downloadBtn.download = `${originalFileName}-compressed.${ext}`;

        loading.classList.add('hidden');
        results.classList.remove('hidden');
      } catch (err) {
        loading.classList.add('hidden');
        tool.querySelector('.upload-shell').classList.remove('hidden');
        showError(err instanceof Error ? err.message : 'Failed to compress image. Please try a different image.');
        console.error(err);
      }
    }

    function clearPreviewUrls() {
      if (originalPreviewUrl) URL.revokeObjectURL(originalPreviewUrl);
      if (compressedPreviewUrl) URL.revokeObjectURL(compressedPreviewUrl);
      originalPreviewUrl = '';
      compressedPreviewUrl = '';

      const originalPreview = tool.querySelector('#original-preview');
      const compressedPreview = tool.querySelector('#compressed-preview');
      originalPreview.removeAttribute('src');
      compressedPreview.removeAttribute('src');
      downloadBtn.removeAttribute('href');
      downloadBtn.removeAttribute('download');
    }

    function showError(msg) {
      error.textContent = msg;
      error.classList.remove('hidden');
    }

    targetBtns.forEach(btn => {
      btn.addEventListener('click', () => setTarget(parseInt(btn.dataset.target)));
    });

    if (customTargetBtn && customTargetInput) {
      customTargetBtn.addEventListener('click', () => {
        const val = parseInt(customTargetInput.value);
        if (val && val > 0 && val <= 5000) {
          setTarget(val);
        }
      });
      customTargetInput.addEventListener('keypress', (e) => {
        if (e.key === 'Enter') customTargetBtn.click();
      });
    }

    uploadArea.addEventListener('click', (e) => {
      e.stopPropagation();
      fileInput.click();
    });

    uploadArea.addEventListener('dragover', (e) => {
      e.preventDefault();
      uploadArea.classList.add('is-dragover');
    });

    uploadArea.addEventListener('dragleave', () => {
      uploadArea.classList.remove('is-dragover');
    });

    uploadArea.addEventListener('drop', (e) => {
      e.preventDefault();
      uploadArea.classList.remove('is-dragover');
      const files = e.dataTransfer.files;
      if (files.length > 0) processFile(files[0]);
    });

    fileInput.addEventListener('change', (e) => {
      if (e.target.files.length > 0) processFile(e.target.files[0]);
      fileInput.value = '';
    });

    compressAnotherBtn.addEventListener('click', () => {
      clearPreviewUrls();
      results.classList.add('hidden');
      tool.querySelector('.upload-shell').classList.remove('hidden');
      setLoadingMessage('Compressing your image…');
    });

    window.addEventListener('pagehide', clearPreviewUrls, { once: true });
    updateTargetButtons();
  })();
</script>
