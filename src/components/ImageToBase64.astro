---
// Simplest tool: image to Base64 data URI, fully client-side.
---

<div class="b64-tool">
  <input type="file" id="b64-input" accept="image/png,image/jpeg,image/webp,image/gif,image/svg+xml" style="display:none !important;" aria-hidden="true" tabindex="-1" />

  <div class="upload-shell">
    <div id="b64-dropzone" class="tool-dropzone" role="button" tabindex="0" aria-label="Upload an image to encode as Base64">
      <span class="tool-dropzone__icon" aria-hidden="true">
        <svg width="25" height="25" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path stroke-linecap="round" stroke-linejoin="round" d="M7.5 8.25h9m-9 3H12m-9.75 1.51c0 1.6 1.123 2.994 2.707 3.227 1.087.16 2.185.283 3.293.369V21l4.076-4.076a1.526 1.526 0 011.037-.443 48.282 48.282 0 005.68-.494c1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0012 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018z"></path></svg>
      </span>
      <div>
        <p class="tool-dropzone__title">Drop your image here</p>
        <p class="tool-dropzone__sub">or click to browse files</p>
      </div>
      <p class="tool-dropzone__meta">JPG &middot; PNG &middot; WebP &middot; GIF &middot; SVG &middot; up to 5MB</p>
    </div>
    <p class="tool-privacy">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z"></path></svg>
      Your images never leave your device, everything happens right here in your browser.
    </p>
  </div>

  <div id="b64-output" class="hidden">
    <div class="b64-head">
      <img id="b64-thumb" class="b64-thumb" alt="Encoded image preview" />
      <p id="b64-meta" class="b64-meta"></p>
    </div>
    <label class="tool-field"><span>Base64 data URI</span>
      <textarea id="b64-text" class="b64-text" rows="8" readonly></textarea>
    </label>
    <div class="b64-actions">
      <button id="b64-copy" class="tool-btn tool-btn--primary" type="button">
        Copy to clipboard
        <span class="tool-btn__chip" aria-hidden="true"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 17.25v3.375c0 .621-.504 1.125-1.125 1.125h-9.75a1.125 1.125 0 01-1.125-1.125V7.875c0-.621.504-1.125 1.125-1.125H6.75a9.06 9.06 0 011.5.124m7.5 10.376h3.375c.621 0 1.125-.504 1.125-1.125V11.25c0-4.46-3.243-8.161-7.5-8.876a9.06 9.06 0 00-1.5-.124H9.375c-.621 0-1.125.504-1.125 1.125v3.5m7.5 10.375H9.375a1.125 1.125 0 01-1.125-1.125v-9.25m12 6.625v-1.875a3.375 3.375 0 00-3.375-3.375h-1.5a1.125 1.125 0 01-1.125-1.125v-1.5a3.375 3.375 0 00-3.375-3.375H9.75"></path></svg></span>
      </button>
      <button id="b64-reset" class="tool-btn tool-btn--ghost" type="button">Encode another image</button>
    </div>
  </div>

  <div id="b64-error" class="tool-error hidden" role="alert"></div>
</div>

<style>
  .b64-head { display: flex; align-items: center; gap: 12px; margin-bottom: 12px; }
  .b64-thumb { width: 56px; height: 56px; object-fit: contain; border: 1px solid var(--line); border-radius: 10px; background: #fff; padding: 4px; }
  .b64-meta { margin: 0; color: var(--muted); font-size: 13.5px; }
  .b64-text { width: 100%; padding: 12px; border: 1px solid var(--line); border-radius: 10px; background: rgba(28,25,23,0.02); color: var(--ink); font-family: 'IBM Plex Mono', monospace; font-size: 12px; line-height: 1.5; word-break: break-all; resize: vertical; }
  .b64-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 12px; }
</style>

<script>
  (function () {
    const tool = document.querySelector('.b64-tool');
    if (!tool) return;
    const dropzone = tool.querySelector('#b64-dropzone');
    const fileInput = tool.querySelector('#b64-input');
    const output = tool.querySelector('#b64-output');
    const thumb = tool.querySelector('#b64-thumb');
    const meta = tool.querySelector('#b64-meta');
    const text = tool.querySelector('#b64-text');
    const copyBtn = tool.querySelector('#b64-copy');
    const errorBox = tool.querySelector('#b64-error');

    dropzone.addEventListener('click', () => fileInput.click());
    dropzone.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); fileInput.click(); } });
    dropzone.addEventListener('dragover', (e) => { e.preventDefault(); dropzone.classList.add('is-dragover'); });
    dropzone.addEventListener('dragleave', () => dropzone.classList.remove('is-dragover'));
    dropzone.addEventListener('drop', (e) => { e.preventDefault(); dropzone.classList.remove('is-dragover'); if (e.dataTransfer.files[0]) encode(e.dataTransfer.files[0]); });
    fileInput.addEventListener('change', (e) => { if (e.target.files[0]) encode(e.target.files[0]); fileInput.value = ''; });

    function encode(file) {
      errorBox.classList.add('hidden');
      if (!file.type.startsWith('image/')) { showError('Please choose an image file.'); return; }
      if (file.size > 5 * 1024 * 1024) { showError('This image is ' + (file.size / 1048576).toFixed(2) + 'MB. The limit is 5MB because Base64 grows about 33% larger.'); return; }
      const reader = new FileReader();
      reader.onload = () => {
        thumb.src = String(reader.result);
        text.value = String(reader.result);
        meta.textContent = file.name + ' \u00b7 ' + (file.size / 1024).toFixed(1) + ' KB original \u00b7 ' + (text.value.length / 1024).toFixed(1) + ' KB as Base64';
        output.classList.remove('hidden');
        dropzone.parentElement.classList.add('hidden');
      };
      reader.onerror = () => showError('This image could not be read in this browser.');
      reader.readAsDataURL(file);
    }

    function showError(m) { errorBox.textContent = m; errorBox.classList.remove('hidden'); }

    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(text.value);
        copyBtn.querySelector('span').textContent = '\u2713';
        setTimeout(() => { copyBtn.querySelector('span').innerHTML = '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 17.25v3.375c0 .621-.504 1.125-1.125 1.125h-9.75a1.125 1.125 0 01-1.125-1.125V7.875c0-.621.504-1.125 1.125-1.125H6.75a9.06 9.06 0 011.5.124m7.5 10.376h3.375c.621 0 1.125-.504 1.125-1.125V11.25c0-4.46-3.243-8.161-7.5-8.876a9.06 9.06 0 00-1.5-.124H9.375c-.621 0-1.125.504-1.125 1.125v3.5m7.5 10.375H9.375a1.125 1.125 0 01-1.125-1.125v-9.25m12 6.625v-1.875a3.375 3.375 0 00-3.375-3.375h-1.5a1.125 1.125 0 01-1.125-1.125v-1.5a3.375 3.375 0 00-3.375-3.375H9.75"></path></svg>'; }, 1600);
      } catch (_) {
        text.select();
        document.execCommand('copy');
      }
    });

    tool.querySelector('#b64-reset').addEventListener('click', () => {
      output.classList.add('hidden');
      text.value = '';
      dropzone.parentElement.classList.remove('hidden');
      errorBox.classList.add('hidden');
    });
  })();
</script>
