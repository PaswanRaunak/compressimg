---
export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  schemaType?: string;
  schemaData?: Record<string, unknown>;
}

const {
  title,
  description,
  canonical = Astro.url.pathname,
  ogImage = '/og-image.png',
  schemaType,
  schemaData = {}
} = Astro.props;

const siteUrl = Astro.site ?? new URL('https://imgcompressor.tools');
const fullCanonical = new URL(canonical, siteUrl).href;
const fullOgImage = new URL(ogImage, siteUrl).href;
const currentYear = new Date().getFullYear();
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isHome = currentPath === '/';
const navLinks = [
  { href: '/#compress', label: 'Compress' },
  { href: '/#process', label: 'How it works' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
const sizeLinks = [20, 30, 50, 100, 200];
const schemaNodes: Record<string, unknown>[] = [
  { '@type': 'Organization', name: 'CompressImg', url: siteUrl },
  { '@type': 'WebSite', name: 'CompressImg', url: siteUrl }
];

if (schemaType === 'WebApplication') {
  schemaNodes.push({
    '@type': 'WebApplication',
    name: 'CompressImg - Free Image Compression Tool',
    description: 'Free online tool to reduce JPG, PNG, and WebP images to a selected maximum file size.',
    url: fullCanonical,
    applicationCategory: 'UtilityApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    featureList: 'Image compression, JPG compression, PNG compression, WebP compression, reduce image size, compress to a maximum file size',
    ...schemaData
  });
}

const schemaMarkup = JSON.stringify({ '@context': 'https://schema.org', '@graph': schemaNodes });
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#faf9f6" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={fullCanonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="CompressImg" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={fullCanonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullOgImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="CompressImg image compression preview" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={fullCanonical} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullOgImage} />
    <meta name="twitter:image:alt" content="CompressImg image compression preview" />
    <script type="application/ld+json" set:html={schemaMarkup} />
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-DYZNTQQZBW"></script>
    <script is:inline define:vars={{ GA_ID: 'G-DYZNTQQZBW' }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', GA_ID);
    </script>
    <meta name="google-site-verification" content="NbmfbG7xjs3ZtsR7c7TVBsHIeID3WnHiNlGzupOc-G8" />
  </head>
  <body class="site-shell">
    <a href="#main-content" class="skip-link">Skip to compressor</a>
    <header class="site-header">
      <div class="site-header__inner">
        <a href="/" class="brand" aria-label="CompressImg home">
          <span class="brand__mark" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
              <rect x="1" y="1" width="14" height="14" rx="4" stroke="currentColor" stroke-width="1.6"></rect>
              <path d="M8 4.5v6M8 10.5L5.5 8M8 10.5L10.5 8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </span>
          <span>CompressImg</span>
        </a>
        <nav class="site-nav" aria-label="Primary navigation">
          {navLinks.map((link) => <a href={link.href} aria-current={currentPath === link.href ? 'page' : undefined}>{link.label}</a>)}
        </nav>
        <a href="/#compress" class="header-cta">Compress now</a>
      </div>
    </header>
    <main id="main-content"><slot /></main>
    <footer class="site-footer">
      <div class="site-footer__inner">
        <div class="site-footer__brand">
          <a href="/" class="brand brand--footer">CompressImg</a>
          <p>Exact-size image compression for forms, email, and the web.</p>
        </div>
        <nav class="site-footer__links" aria-label="Compression sizes">
          {sizeLinks.map((size) => <a href={`/compress-image-to-${size}kb`}>Compress to {size}KB</a>)}
        </nav>
        <div class="site-footer__meta">
          <div class="site-footer__legal">
            <a href="/privacy-policy">Privacy policy</a>
            <a href="/terms">Terms of service</a>
          </div>
          <p class="site-footer__copyright">&copy; {currentYear} CompressImg</p>
        </div>
      </div>
    </footer>
    <style is:global>
      :root {
        --paper: #faf9f6;
        --card: #ffffff;
        --ink: #1c1917;
        --muted: #57534e;
        --faint: #a8a29e;
        --line: #e7e5e4;
        --line-strong: #d6d3d1;
        --accent: #386853;
        --accent-strong: #2e5443;
        --accent-soft: #f0f6f2;
        --danger: #b3261e;
      }
      * { box-sizing: border-box; }
      html { background: var(--paper); scroll-behavior: smooth; }
      body.site-shell { min-width: 320px; margin: 0; background: var(--paper); color: var(--ink); font-family: 'Outfit', 'Segoe UI', Arial, sans-serif; font-size: 16px; line-height: 1.6; -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility; }
      ::selection { background: #dcebe2; }
      .site-shell :focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; border-radius: 2px; }
      .skip-link { position: fixed; z-index: 80; top: 12px; left: 12px; padding: 12px 16px; border-radius: 10px; background: var(--ink); color: #fff; font-weight: 600; text-decoration: none; transform: translateY(-180%); transition: transform 180ms cubic-bezier(0.32,0.72,0,1); }
      .skip-link:focus { transform: translateY(0); }

      .site-header { position: sticky; z-index: 40; top: 0; border-bottom: 1px solid var(--line); background: rgba(250, 249, 246, 0.86); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); }
      .site-header__inner { display: flex; align-items: center; gap: 20px; max-width: 1180px; min-height: 64px; margin: 0 auto; padding: 10px 24px; }
      .brand { display: inline-flex; align-items: center; gap: 9px; color: var(--ink); font-size: 17px; font-weight: 700; letter-spacing: -0.01em; text-decoration: none; }
      .brand__mark { display: inline-flex; align-items: center; justify-content: center; width: 30px; height: 30px; border-radius: 9px; background: var(--accent); color: #fff; }
      .site-nav { display: flex; gap: 4px; margin-left: auto; overflow-x: auto; scrollbar-width: none; }
      .site-nav::-webkit-scrollbar { display: none; }
      .site-nav a { display: inline-flex; align-items: center; padding: 8px 13px; border-radius: 999px; color: var(--muted); font-size: 14.5px; font-weight: 500; text-decoration: none; white-space: nowrap; transition: color 160ms ease, background-color 160ms ease; }
      .site-nav a:hover { color: var(--ink); background: rgba(28, 25, 23, 0.05); }
      .site-nav a[aria-current='page'] { color: var(--ink); background: rgba(28, 25, 23, 0.07); font-weight: 600; }
      .header-cta { display: inline-flex; align-items: center; min-height: 40px; padding: 0 18px; border-radius: 999px; background: var(--ink); color: #fff; font-size: 14px; font-weight: 600; text-decoration: none; transition: background-color 160ms ease, transform 160ms ease; }
      .header-cta:hover { background: #33302c; }
      .header-cta:active { transform: scale(0.98); }

      .site-footer { border-top: 1px solid var(--line); background: var(--paper); }
      .site-footer__inner { display: grid; gap: 36px; max-width: 1180px; margin: 0 auto; padding: 52px 24px 44px; }
      .site-footer__brand p { max-width: 34ch; margin: 12px 0 0; color: var(--muted); font-size: 14.5px; }
      .brand--footer { font-size: 16px; }
      .site-footer__links { display: flex; flex-wrap: wrap; gap: 4px 22px; }
      .site-footer__links a { color: var(--muted); font-size: 14.5px; font-weight: 500; text-decoration: none; transition: color 160ms ease; }
      .site-footer__links a:hover { color: var(--accent-strong); text-decoration: underline; text-underline-offset: 3px; }
      .site-footer__meta { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; padding-top: 22px; border-top: 1px solid var(--line); }
      .site-footer__legal { display: flex; gap: 20px; }
      .site-footer__legal a, .site-footer__copyright { color: var(--faint); font-size: 13px; }
      .site-footer__legal a { text-decoration: none; transition: color 160ms ease; }
      .site-footer__legal a:hover { color: var(--ink); }
      .site-footer__copyright { margin: 0; }

      @media (max-width: 44rem) {
        .site-header__inner { flex-wrap: wrap; gap: 8px 12px; }
        .site-nav { order: 3; width: 100%; margin-left: -13px; }
        .header-cta { margin-left: auto; }
      }
      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        *, *::before, *::after { animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; scroll-behavior: auto !important; transition-duration: 0.01ms !important; }
      }
    </style>
  </body>
</html>
