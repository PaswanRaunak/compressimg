---
import Layout from '../layouts/Layout.astro';
const title = 'Page Not Found - CompressImg';
const description = 'The page you are looking for does not exist. Return to CompressImg homepage to compress your images.';
---
<Layout title={title} description={description}>
  <section class="flex min-h-[60vh] items-center py-24">
    <div class="mx-auto max-w-lg px-4">
      <p class="font-mono text-sm font-medium tracking-[0.18em] text-accent-600">Error 404</p>
      <h1 class="mt-4 text-5xl font-semibold leading-[1.05] tracking-tightest text-stone-900">Page not found</h1>
      <p class="mt-5 max-w-[55ch] leading-relaxed text-stone-600">The page you're looking for doesn't exist or has been moved. You can still compress your images from the homepage.</p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href="/" class="group inline-flex items-center gap-2 rounded-full bg-stone-900 py-2.5 pl-6 pr-2.5 text-sm font-semibold text-white transition duration-200 ease-out hover:bg-stone-700 active:scale-[0.98]">
          Back to home
          <span class="flex h-8 w-8 items-center justify-center rounded-full bg-white/15 transition-transform duration-200 ease-out group-hover:translate-x-0.5">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"></path>
            </svg>
          </span>
        </a>
        <a href="/compress-image-to-100kb" class="inline-flex items-center rounded-full border border-stone-300 px-6 py-3 text-sm font-medium text-stone-600 transition duration-200 hover:border-stone-400 hover:bg-stone-100 active:scale-[0.98]">Compress to 100KB</a>
      </div>
      <div class="mt-14 border-t border-stone-200 pt-8">
        <p class="font-mono text-[11px] font-medium uppercase tracking-[0.16em] text-stone-400">Popular pages</p>
        <div class="mt-4 flex flex-wrap gap-2">
          <a href="/compress-image-to-20kb" class="rounded-full border border-stone-200 bg-white px-4 py-2 font-mono text-sm text-stone-600 transition duration-200 hover:border-accent-600 hover:text-accent-700">20KB</a>
          <a href="/compress-image-to-30kb" class="rounded-full border border-stone-200 bg-white px-4 py-2 font-mono text-sm text-stone-600 transition duration-200 hover:border-accent-600 hover:text-accent-700">30KB</a>
          <a href="/compress-image-to-50kb" class="rounded-full border border-stone-200 bg-white px-4 py-2 font-mono text-sm text-stone-600 transition duration-200 hover:border-accent-600 hover:text-accent-700">50KB</a>
          <a href="/compress-image-to-100kb" class="rounded-full border border-stone-200 bg-white px-4 py-2 font-mono text-sm text-stone-600 transition duration-200 hover:border-accent-600 hover:text-accent-700">100KB</a>
          <a href="/compress-image-to-200kb" class="rounded-full border border-stone-200 bg-white px-4 py-2 font-mono text-sm text-stone-600 transition duration-200 hover:border-accent-600 hover:text-accent-700">200KB</a>
          <a href="/about" class="rounded-full border border-stone-200 bg-white px-4 py-2 text-sm text-stone-600 transition duration-200 hover:border-accent-600 hover:text-accent-700">About</a>
          <a href="/contact" class="rounded-full border border-stone-200 bg-white px-4 py-2 text-sm text-stone-600 transition duration-200 hover:border-accent-600 hover:text-accent-700">Contact</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
