---
import Layout from '../layouts/Layout.astro';
import CompressTool from '../components/CompressTool.astro';
import { tools, toolIconPaths } from '../lib/tools';

const title = 'Compress Images to Exact Sizes Online | CompressImg';
const description = 'Compress JPG, PNG, and WebP images to an exact target size. Create free, optimized files for forms, email, and web uploads, no signup required.';
const sizes = [20, 30, 50, 100, 200];
const faqItems = [
  { question: 'Which image formats can I compress?', answer: 'CompressImg accepts JPG, PNG, and WebP files up to 20MB.' },
  { question: 'Does CompressImg keep my images?', answer: 'The Cloudflare Worker processes image bytes in memory and does not keep an image copy. TinyPNG may retain submitted content temporarily under its terms.' },
  { question: 'Can I set a custom file size?', answer: 'Yes. Use the custom target input to enter any target between 1KB and 5000KB.' }
];
---

<Layout title={title} description={description} schemaType="WebApplication" faqItems={faqItems}>
  <section class="hero" id="compress">
    <div class="hero__intro">
      <p class="kicker"><span class="kicker__dot" aria-hidden="true"></span>Free image compressor</p>
      <h1>Compress any image to an <em>exact size</em>.</h1>
      <p class="hero__summary">Set the limit, drop in an image, and download a file that stays under it. Built for form uploads, email attachments, product listings, and fast pages.</p>
      <div class="hero__actions">
        <span class="hero__hint">Pick a target size in the panel to start, no account needed.</span>
      </div>
      <dl class="hero__facts" aria-label="Compressor capabilities">
        <div><dt>Formats</dt><dd>JPG, PNG, WebP</dd></div>
        <div><dt>Max upload</dt><dd>20MB</dd></div>
        <div><dt>Account</dt><dd>Not required</dd></div>
      </dl>
    </div>
    <div class="hero__tool" aria-label="Image compression workspace">
      <div class="tool-card">
        <div class="tool-card__head">
          <span>Compression bench</span>
          <span class="tool-card__badge" aria-hidden="true">Free</span>
        </div>
        <CompressTool defaultTarget={100} showCustomTarget={true} />
      </div>
    </div>
  </section>

  <section class="tools-grid" aria-labelledby="tools-grid-title">
    <div class="tools-grid__head">
      <p class="kicker"><span class="kicker__dot" aria-hidden="true"></span>All tools</p>
      <h2 id="tools-grid-title">Everything runs in your browser.</h2>
    </div>
    <div class="tools-grid__grid">
      {tools.map((t) => (
        <a href={t.href}>
          <span class="tools-grid__icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
              <path stroke-linecap="round" stroke-linejoin="round" d={toolIconPaths[t.icon]}></path>
            </svg>
          </span>
          <strong>{t.name}</strong>
          <span class="tools-grid__desc">{t.description}</span>
          <span class="tools-grid__group">{t.group}</span>
        </a>
      ))}
    </div>
  </section>

  <section id="process" class="process">
    <div class="process__head">
      <p class="kicker"><span class="kicker__dot" aria-hidden="true"></span>How it works</p>
      <h2>Four steps, nothing hidden.</h2>
    </div>
    <ol class="process__list">
      <li><span class="process__num">01</span><div><h3>Set the ceiling</h3><p>Choose a preset or enter the exact limit the destination requires.</p></div></li>
      <li><span class="process__num">02</span><div><h3>Drop in one image</h3><p>The tool checks the format and size before any work begins.</p></div></li>
      <li><span class="process__num">03</span><div><h3>Keep the useful detail</h3><p>TinyPNG optimizes first; quality and dimensions are adjusted locally only when needed.</p></div></li>
      <li><span class="process__num">04</span><div><h3>Download with proof</h3><p>Compare before and after sizes, then take the compressed file.</p></div></li>
    </ol>
  </section>

  <section class="targets" aria-labelledby="targets-title">
    <div class="targets__head">
      <p class="kicker"><span class="kicker__dot" aria-hidden="true"></span>Common limits</p>
      <h2 id="targets-title">Start from the size you were given.</h2>
    </div>
    <div class="targets__grid">
      {sizes.map((size) => <a href={`/compress-image-to-${size}kb`}><strong>{size}<small>KB</small></strong><span>Compress to {size}KB</span></a>)}
    </div>
  </section>

  <section class="details">
    <article>
      <p class="kicker"><span class="kicker__dot" aria-hidden="true"></span>Privacy</p>
      <h2>Compression without the vague parts.</h2>
      <p>Images travel over HTTPS to a Cloudflare Worker and on to TinyPNG for perceptual optimization. The Worker processes bytes in memory and keeps no image copy. If a result still exceeds your limit, the browser re-encodes it locally and adjusts dimensions only as needed.</p>
      <a class="arrow-link" href="/privacy-policy">Read the privacy details</a>
    </article>
    <aside class="details__note">
      <p>Quality depends on the source image and the target you choose.</p>
      <strong>For the best result, choose the largest limit your destination accepts.</strong>
    </aside>
  </section>

  <section class="faq" aria-labelledby="faq-title">
    <div class="faq__head">
      <p class="kicker"><span class="kicker__dot" aria-hidden="true"></span>Questions</p>
      <h2 id="faq-title">Useful details before you start.</h2>
    </div>
    <div class="faq__list">
      {faqItems.map((item) => <details><summary>{item.question}</summary><p>{item.answer}</p></details>)}
    </div>
  </section>

  <style>
    section { max-width: 1180px; margin: 0 auto; padding: 0 24px; }
    .kicker { display: inline-flex; align-items: center; gap: 8px; margin: 0; color: var(--accent-strong); font-family: 'Geist Mono', monospace; font-size: 12px; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; }
    .kicker__dot { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); }
    h1, h2, h3 { margin: 0; color: var(--ink); text-wrap: balance; }

    .hero { display: grid; gap: 48px; align-items: center; padding-top: 56px; padding-bottom: 88px; }
    .hero__intro h1 { max-width: 13ch; margin-top: 20px; font-size: clamp(40px, 5.6vw, 66px); font-weight: 700; letter-spacing: -0.032em; line-height: 1.02; }
    .hero__intro h1 em { color: var(--accent-strong); font-style: normal; }
    .hero__summary { max-width: 50ch; margin: 22px 0 0; color: var(--muted); font-size: 17.5px; line-height: 1.65; }
    .hero__hint { display: inline-block; margin-top: 24px; color: var(--muted); font-size: 14.5px; }
    .hero__facts { display: grid; grid-template-columns: repeat(3, auto); justify-content: start; gap: 40px; margin: 34px 0 0; padding-top: 24px; border-top: 1px solid var(--line); }
    .hero__facts dt { color: var(--faint); font-family: 'Geist Mono', monospace; font-size: 11px; letter-spacing: 0.07em; text-transform: uppercase; }
    .hero__facts dd { margin: 6px 0 0; font-size: 14.5px; font-weight: 600; }
    .tool-card { overflow: hidden; border: 1px solid var(--line); border-radius: 24px; background: var(--card); box-shadow: 0 2px 6px rgba(0,0,0,0.04), 0 36px 70px -36px rgba(0,0,0,0.25); }
    .tool-card__head { display: flex; align-items: center; justify-content: space-between; padding: 14px 20px; border-bottom: 1px solid var(--line); color: var(--muted); font-family: 'Geist Mono', monospace; font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; }
    .tool-card__badge { padding: 3px 10px; border-radius: 999px; background: var(--accent-soft); color: var(--accent-strong); font-weight: 600; }

    .process { padding-top: 72px; padding-bottom: 72px; border-top: 1px solid var(--line); }
    .tools-grid { padding-top: 72px; padding-bottom: 72px; border-top: 1px solid var(--line); }
    .tools-grid h2 { max-width: 16ch; margin-top: 14px; font-size: clamp(28px, 3.6vw, 42px); font-weight: 700; letter-spacing: -0.025em; line-height: 1.08; }
    .tools-grid__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; margin-top: 40px; }
    .tools-grid__grid a { position: relative; display: flex; flex-direction: column; gap: 7px; padding: 18px; border: 1px solid var(--line); border-radius: 16px; background: var(--card); text-decoration: none; transition: border-color 180ms ease, transform 180ms ease, box-shadow 180ms ease; }
    .tools-grid__grid a:hover { border-color: var(--accent); box-shadow: 0 12px 28px -18px rgba(46,84,67,0.45); transform: translateY(-2px); }
    .tools-grid__icon { display: inline-flex; align-items: center; justify-content: center; width: 34px; height: 34px; border-radius: 10px; background: var(--accent-soft); color: var(--accent-strong); }
    .tools-grid__grid strong { color: var(--ink); font-size: 15px; font-weight: 600; letter-spacing: -0.01em; }
    .tools-grid__desc { color: var(--muted); font-size: 13px; line-height: 1.5; }
    .tools-grid__group { color: var(--faint); font-family: 'Geist Mono', monospace; font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase; }
    @media (max-width: 56rem) { .tools-grid__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
    @media (max-width: 34rem) { .tools-grid__grid { grid-template-columns: 1fr; } }
    .process h2 { max-width: 14ch; margin-top: 14px; font-size: clamp(28px, 3.6vw, 42px); font-weight: 700; letter-spacing: -0.025em; line-height: 1.08; }
    .process__list { display: grid; gap: 0 56px; padding: 0; margin: 44px 0 0; list-style: none; }
    .process__list li { display: grid; grid-template-columns: 52px 1fr; gap: 16px; padding: 26px 0; border-top: 1px solid var(--line); }
    .process__num { color: var(--accent); font-family: 'Geist Mono', monospace; font-size: 13px; font-weight: 500; padding-top: 4px; }
    .process__list h3 { font-size: 18px; font-weight: 600; letter-spacing: -0.01em; }
    .process__list p { max-width: 44ch; margin: 7px 0 0; color: var(--muted); font-size: 15px; line-height: 1.6; }

    .targets { display: grid; gap: 36px; padding-top: 72px; padding-bottom: 72px; border-top: 1px solid var(--line); }
    .targets h2 { max-width: 16ch; margin-top: 14px; font-size: clamp(28px, 3.6vw, 42px); font-weight: 700; letter-spacing: -0.025em; line-height: 1.08; }
    .targets__grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 12px; }
    .targets__grid a { display: flex; flex-direction: column; gap: 26px; padding: 18px; border: 1px solid var(--line); border-radius: 16px; background: var(--card); text-decoration: none; transition: border-color 180ms ease, transform 180ms ease, box-shadow 180ms ease; }
    .targets__grid a:hover { border-color: var(--accent); box-shadow: 0 12px 28px -18px rgba(46,84,67,0.45); transform: translateY(-2px); }
    .targets__grid strong { color: var(--ink); font-size: 30px; font-weight: 700; letter-spacing: -0.02em; }
    .targets__grid strong small { margin-left: 2px; color: var(--accent-strong); font-size: 15px; font-weight: 600; }
    .targets__grid span { color: var(--muted); font-size: 13px; }

    .details { display: grid; gap: 40px; align-items: end; padding-top: 72px; padding-bottom: 72px; border-top: 1px solid var(--line); }
    .details h2 { max-width: 15ch; margin-top: 14px; font-size: clamp(28px, 3.6vw, 42px); font-weight: 700; letter-spacing: -0.025em; line-height: 1.08; }
    .details article > p:not(.kicker) { max-width: 56ch; margin: 20px 0 0; color: var(--muted); font-size: 16px; line-height: 1.7; }
    .arrow-link { display: inline-block; margin-top: 20px; color: var(--accent-strong); font-weight: 600; text-decoration: none; border-bottom: 2px solid #bcd7c8; padding-bottom: 2px; transition: border-color 160ms ease; }
    .arrow-link:hover { border-color: var(--accent-strong); }
    .details__note { padding: 26px; border-radius: 16px; border: 1px solid var(--line); border-left: 3px solid var(--accent); background: var(--accent-soft); }
    .details__note p { margin: 0; color: var(--muted); font-size: 14.5px; line-height: 1.55; }
    .details__note strong { display: block; margin-top: 12px; color: var(--accent-strong); font-size: 15.5px; line-height: 1.45; letter-spacing: -0.01em; }

    .faq { display: grid; gap: 32px; padding-top: 72px; padding-bottom: 96px; border-top: 1px solid var(--line); }
    .faq h2 { max-width: 14ch; margin-top: 14px; font-size: clamp(28px, 3.6vw, 42px); font-weight: 700; letter-spacing: -0.025em; line-height: 1.08; }
    .faq__list { border-top: 1px solid var(--line); }
    .faq__list details { border-bottom: 1px solid var(--line); }
    .faq__list summary { position: relative; display: flex; align-items: center; min-height: 60px; padding: 14px 40px 14px 0; color: var(--ink); font-weight: 600; font-size: 16px; cursor: pointer; list-style: none; transition: color 160ms ease; }
    .faq__list summary:hover { color: var(--accent-strong); }
    .faq__list summary::-webkit-details-marker { display: none; }
    .faq__list summary::after { content: ''; position: absolute; right: 8px; top: 50%; width: 9px; height: 9px; border-right: 1.8px solid var(--accent); border-bottom: 1.8px solid var(--accent); transform: translateY(-70%) rotate(45deg); transition: transform 200ms ease; }
    .faq__list details[open] summary::after { transform: translateY(-30%) rotate(225deg); }
    .faq__list p { max-width: 62ch; margin: 0; padding: 0 40px 20px 0; color: var(--muted); font-size: 15px; line-height: 1.65; }

    @media (min-width: 56rem) {
      .hero { grid-template-columns: minmax(0, 0.9fr) minmax(460px, 1.1fr); gap: 64px; padding-top: 84px; padding-bottom: 104px; }
      .process__list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .process__list li:nth-child(2) { border-top: none; }
      .targets { grid-template-columns: minmax(260px, 0.62fr) 1fr; align-items: end; }
      .details { grid-template-columns: minmax(0, 1fr) minmax(280px, 0.42fr); }
      .faq { grid-template-columns: minmax(260px, 0.55fr) 1fr; }
    }
    @media (max-width: 56rem) {
      .targets__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .hero__facts { gap: 28px; }
    }
    @media (max-width: 30rem) {
      .targets__grid { grid-template-columns: 1fr; }
      .hero__facts { grid-template-columns: 1fr 1fr; gap: 20px; }
    }
  </style>
</Layout>
